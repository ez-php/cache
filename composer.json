{
  "name": "ez-php/cache",
  "version": "2.6.4",
  "description": "Cache module for the ez-php framework — array, file, and Redis drivers with a unified interface",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["cache", "redis", "php", "framework", "ez-php"],
  "homepage": "https://github.com/ez-php/cache",
  "support": {
    "issues": "https://github.com/ez-php/cache/issues",
    "source": "https://github.com/ez-php/cache"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.6.0"
  },
  "suggest": {
    "ext-redis": "Needed for RedisDriver",
    "ext-memcached": "Needed for MemcachedDriver",
    "ext-apcu": "Needed for ApcuDriver (CLI: apc.enable_cli=1)",
    "ez-php/console": "Needed for the cache:clear and cache:prune commands"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "ez-php/testing-application": "^2.6.0",
    "ez-php/console": "^2.6.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
